  "license": "CC0",
  "default_frame_duration_ms": 100,
  "characters": {
    "cat": {
      "path": "png/cat",
      "animations": {
        "idle": { "pattern": "Idle ({index}).png", "frame_count": 10, "frame_duration_ms": 120, "loop": true },

        "jump": { "pattern": "Jump ({index}).png", "frame_count": 8, "frame_duration_ms": 100, "loop": false }
      }
    },
    "dog": {
      "path": "png/dog",
      "animations": {
        "idle": { "pattern": "Idle ({index}).png", "frame_count": 10, "frame_duration_ms": 120, "loop": true },
        "walk": { "pattern": "Walk ({index}).png", "frame_count": 10, "loop": true },
        "jump": { "pattern": "Jump ({index}).png", "frame_count": 8, "frame_duration_ms": 100, "loop": false }
      }
    }
  }
}

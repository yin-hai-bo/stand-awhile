#include <winver.h>
#include "app_version.h"

1 ICON "assets/app.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION APP_VERSION_WORDS
PRODUCTVERSION APP_VERSION_WORDS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "yinhaibo"
            VALUE "FileDescription", "Stand Awhile - Movement break reminder"
            VALUE "FileVersion", APP_VERSION_STRING
            VALUE "InternalName", "stand-awhile"
            VALUE "OriginalFilename", "stand-awhile.exe"
            VALUE "ProductName", "Stand Awhile"
            VALUE "ProductVersion", APP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
